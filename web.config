<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
        <add value="index.php" />
      </files>
    </defaultDocument>
    <rewrite>
      <rules>
        <rule name="Redirect Legacy HTM" stopProcessing="true">
          <match url=".*\.htm$" ignoreCase="true" />
          <action type="Redirect" url="https://www.solimene.net/" redirectType="Permanent" />
        </rule>
        <rule name="Redirect Ilgiraweb" stopProcessing="true">
          <match url=".*ilgiraweb.*" ignoreCase="true" />
          <action type="Redirect" url="https://www.solimene.net/" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
